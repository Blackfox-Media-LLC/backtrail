{
  "name": "backtrail-vendor-build",
  "version": "1.0.0",
  "description": "Builds webapp/vendor/meshtastic.js from the official Meshtastic packages",
  "main": "index.js",
  "scripts": {
    "build": "npm run build:meshtastic && npm run build:native && npm run build:libs",
    "build:meshtastic": "esbuild entry.js --bundle --format=esm --platform=browser --target=es2020 --minify --legal-comments=inline --alias:os=./shims/os.js --alias:path=./shims/path.js --alias:util=./shims/util.js --inject:./shims/process-shim.js --inject:./shims/buffer-shim.js --outfile=../webapp/vendor/meshtastic.js",
    "build:native": "esbuild entry-native.js --bundle --format=esm --platform=browser --target=es2020 --minify --legal-comments=inline --outfile=../webapp/vendor/native.js",
    "build:libs": "esbuild entry-libs.js --bundle --format=esm --platform=browser --target=es2020 --minify --legal-comments=inline --outfile=../webapp/vendor/libs.js && node -e \"require('fs').copyFileSync('node_modules/leaflet/dist/leaflet.css','../webapp/vendor/leaflet.css')\""
  },
  "keywords": [],
  "author": "",
  "license": "GPL-3.0-only",
  "type": "commonjs",
  "dependencies": {
    "@bufbuild/protobuf": "^2.16.0",
    "@capacitor-community/bluetooth-le": "8.3.0",
    "@capacitor/barcode-scanner": "^3.1.3",
    "@capacitor/core": "8.5.3",
    "@capacitor/filesystem": "^8.1.4",
    "@capacitor/geolocation": "^8.2.3",
    "@capacitor/local-notifications": "^8.3.1",
    "@capacitor/share": "^8.0.3",
    "@capawesome-team/capacitor-android-foreground-service": "^8.1.0",
    "@meshtastic/core": "^2.6.7",
    "@meshtastic/transport-web-bluetooth": "^0.1.5",
    "@meshtastic/transport-web-serial": "^0.2.5",
    "esbuild": "^0.24.2",
    "leaflet": "^1.9.4",
    "qrcode-generator": "^2.0.4"
  },
  "private": true
}
